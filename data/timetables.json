    "_schema": "Timetable",
    "_description": [
      "One timetable document per realm.",
      "The schedule is split into 'odd' and 'even' week keys.",
      "Each week key contains the 7 days of the week.",
      "Each day contains an ordered array of Period objects.",
      "",
      "Period fields:",
      "  id           – unique within the realm (used as FK in attendance)",
      "  subjectCode  – short code displayed on mobile (e.g. 'MATH')",
      "  subjectName  – full name for desktop/detail view",
      "  teacher      – display name of the teacher",
      "  room         – room/location string",
      "  startTime    – 24-h 'HH:MM' local time (timezone from realm settings)",
      "  endTime      – 24-h 'HH:MM' local time",
      "  attendanceRequired – boolean; if false no check-in is tracked"
    ]
