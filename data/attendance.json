      "Fields:",
      "  id         – uuid v4",
      "  realmId    – scope guard",
      "  userId     – the student",
      "  date       – ISO date string 'YYYY-MM-DD' (local date, no TZ offset)",
      "  weekType   – 'odd' | 'even' (resolved at write time by the server)",
      "  periodId   – FK → timetable period id",
      "  status     – 'present' | 'absent' | 'pending'",
      "  checkedInAt – ISO DateTime when the student pressed check-in (null if absent)"
    ]
