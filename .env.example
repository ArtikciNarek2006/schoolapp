# ──────────────────────────────────────────────
#  Server
# ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ──────────────────────────────────────────────
#  Security
# ──────────────────────────────────────────────
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changeme_replace_with_a_very_long_random_secret
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────────
#  Project Admin credentials (bootstrapped on first run)
# ──────────────────────────────────────────────
PROJECT_ADMIN_USERNAME=superadmin
PROJECT_ADMIN_PASSWORD=Admin@1234

# ──────────────────────────────────────────────
#  File uploads
# ──────────────────────────────────────────────
MAX_FILE_SIZE_MB=25
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
UPLOAD_DIR=uploads
